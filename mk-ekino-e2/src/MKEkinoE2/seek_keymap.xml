<?xml version="1.0" encoding="UTF-8"?>
<!-- Private context; active only while this plugin's MoviePlayer is executing.
     DPAD make/repeat seeks once. Its break/long are consumed to prevent the
     second OpenATV InfobarSeekActions break binding from jumping twice.
     eActionMap suppresses break after a handled long press. -->
<keymap>
  <map context="MKEkinoStreamSeekActions">
    <key id="KEY_LEFT" mapto="left" flags="mr" />
    <key id="KEY_RIGHT" mapto="right" flags="mr" />
    <key id="KEY_LEFT" mapto="consume" flags="bl" />
    <key id="KEY_RIGHT" mapto="consume" flags="bl" />
    <key id="KEY_REWIND" mapto="consume" flags="m" />
    <key id="KEY_FASTFORWARD" mapto="consume" flags="m" />
    <key id="KEY_REWIND" mapto="seekBack" flags="b" />
    <key id="KEY_FASTFORWARD" mapto="seekFwd" flags="b" />
    <key id="KEY_REWIND" mapto="seekBackManual" flags="l" />
    <key id="KEY_FASTFORWARD" mapto="seekFwdManual" flags="l" />
    <key id="KEY_PREVIOUSSONG" mapto="consume" flags="m" />
    <key id="KEY_NEXTSONG" mapto="consume" flags="m" />
    <key id="KEY_PREVIOUSSONG" mapto="seekBack" flags="b" />
    <key id="KEY_NEXTSONG" mapto="seekFwd" flags="b" />
    <key id="KEY_PREVIOUSSONG" mapto="seekBackManual" flags="l" />
    <key id="KEY_NEXTSONG" mapto="seekFwdManual" flags="l" />
    <key id="KEY_PLAY" mapto="play" flags="m" />
    <key id="KEY_PLAYPAUSE" mapto="play" flags="m" />
    <key id="KEY_PAUSE" mapto="pause" flags="m" />
    <key id="KEY_PLAY" mapto="consume" flags="bl" />
    <key id="KEY_PLAYPAUSE" mapto="consume" flags="bl" />
    <key id="KEY_PAUSE" mapto="consume" flags="bl" />
  </map>
</keymap>
